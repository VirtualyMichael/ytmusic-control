{
  "manifest_version": 3,
  "name": "YouTube Music Control bridge",
  "version": "1.0.0",
  "description": "Lets a program on this PC (a CLI, an AI agent skill or an MCP server) search and play songs in your signed-in YouTube Music. Talks only to 127.0.0.1 and only touches music.youtube.com.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}